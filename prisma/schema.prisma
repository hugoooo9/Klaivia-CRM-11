// Klaivia CRM — schéma Prisma simplifié
// Base SQLite locale, pas de serveur distant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./klaivia.db"
}

// Un prospect = contact commercial à tracker dans le pipeline
model Prospect {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Identité
  prenom        String
  nom           String
  entreprise    String?
  ville         String?
  canton        String?
  npa           String?
  adresse       String?
  email         String?
  phone         String?
  instagram     String?
  linkedin      String?
  siteWeb       String?

  // Qualification
  secteur       String
  canal         String
  statut        String   @default("Nouveau")
  urgence       String   @default("Normale")
  score         Int      @default(3)

  // Suivi commercial
  dateContact   DateTime @default(now())
  prochainStep  DateTime?
  packInteret   String?
  budgetEstime  Int?
  setupEstime   Int?

  // Notes
  notes         String?
  raisonPerte   String?

  // Origine de la donnée — utilisé pour distinguer manuel vs import
  source        String   @default("MANUAL") // MANUAL | IMPORT_CSV

  // Relations
  interactions  Interaction[]
  client        Client?
  tasks         Task[]
  tags          ProspectTag[]
  activities    Activity[]
  emails        ProspectEmail[]
  attachments   Attachment[]

  @@index([statut])
  @@index([urgence])
  @@index([prochainStep])
  @@index([source])
}

// Interactions = trace de chaque contact posé avec le prospect
model Interaction {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  type        String   // LinkedIn DM | Email | Appel | Démo | Audit | Relance | Note
  contenu     String
  prospect    Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId  String

  @@index([prospectId])
}

// Tasks = todos liées à un prospect (ou globales si prospectId null)
model Task {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  titre       String
  description String?
  dueDate     DateTime?
  done        Boolean   @default(false)
  priorite    String    @default("Normale") // Haute | Normale | Faible
  prospect    Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId  String?

  @@index([prospectId])
  @@index([done])
  @@index([dueDate])
}

// Tag libre — appliqué à un ou plusieurs prospects
model Tag {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  label     String        @unique
  color     String        @default("#5B3FA6") // hex pour pastille
  prospects ProspectTag[]
}

// Jonction many-to-many Prospect ↔ Tag
model ProspectTag {
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId      String

  @@id([prospectId, tagId])
  @@index([tagId])
}

// Activity log auto — chaque changement de statut, création task, etc.
model Activity {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  type        String   // STATUT_CHANGE | TASK_DONE | NOTE | EMAIL_SENT | INTERACTION
  description String
  meta        String?  // JSON stringifié pour contexte (anciens/nouveaux statuts)
  prospect    Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId  String

  @@index([prospectId])
  @@index([createdAt])
}

// Pièces jointes (devis, contrats, propositions) attachées à un prospect.
// Stocké en base64 dans une colonne TEXT pour compat Prisma + SQLite Hostinger.
model Attachment {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  prospect    Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId  String
  filename    String
  mimeType    String
  size        Int
  dataBase64  String   // contenu encodé base64

  @@index([prospectId])
}

// Mail d'approche — stocké comme brouillon, programmé ou envoyé
model ProspectEmail {
  id          String    @id @default(cuid())
  prospect    Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId  String
  subject     String
  body        String
  status      String    // "draft" | "scheduled" | "sent" | "failed"
  scheduledAt DateTime? // si status="scheduled" → date d'envoi prévue
  sentAt      DateTime? // si status="sent" → date envoi réelle
  errorMsg    String?   // si status="failed" → message d'erreur
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([prospectId])
  @@index([status])
  @@index([scheduledAt])
}

// Templates email/LinkedIn réutilisables
model Template {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  nom       String
  type      String   // EMAIL | LINKEDIN | DM | NOTE
  sujet     String?
  contenu   String
  variables String?  // JSON liste vars dispo : {prenom}, {entreprise}…

  @@index([type])
}

// Un client = prospect signé, avec un contrat actif
model Client {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  prospect      Prospect @relation(fields: [prospectId], references: [id])
  prospectId    String   @unique

  pack          String
  mrrCHF        Int
  setupCHF      Int
  dateDebut     DateTime
  prochainRDV   DateTime?

  nps           Int?
  statut        String   @default("Actif")

  notes         String?

  @@index([statut])
}

// Stats d'activité hebdomadaires saisies manuellement
model KPI {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  semaine   Int
  annee     Int
  dmEnvoyes Int      @default(0)
  reponses  Int      @default(0)
  appels    Int      @default(0)
  demos     Int      @default(0)
  closes    Int      @default(0)
  mrr       Int      @default(0)

  @@unique([annee, semaine])
}
