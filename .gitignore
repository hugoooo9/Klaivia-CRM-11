# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# exception : le template DOIT être versionné (pas de secret dedans)
!.env.example

# Prisma SQLite local — la base est recréée à chaque déploiement via `prisma migrate`
prisma/*.db
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal

# vercel
.vercel

# dossier local perso (jamais poussé — contient notes, clés d'API en clair, etc.)
/.public/

# typescript
*.tsbuildinfo
next-env.d.ts
