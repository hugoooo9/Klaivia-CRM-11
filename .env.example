# Klaivia CRM — variables d'environnement
# Copier vers .env et renseigner les valeurs avant de lancer l'app.

# ─── DB (SQLite local par défaut) ───
DATABASE_URL="file:./klaivia.db"

# ─── Auth (login d'accès au site) ───
# Liste de mots de passe valides séparés par virgules — un par utilisateur (toi + collègue).
# Tout user qui connaît un de ces passwords accède au CRM.
AUTH_PASSWORDS="changeme1,changeme2"
# Secret pour signer le cookie de session (>= 16 chars, random).
# Générer : `openssl rand -hex 32` ou tout string aléatoire long.
AUTH_SECRET=""

# ─── Mail d'approche IA (Gemini / Google AI Studio) ───
# Clé API Gemini, gratuite jusqu'à 1500 requêtes/jour.
# 1. Va sur https://aistudio.google.com/apikey
# 2. Connecte-toi avec un compte Google
# 3. Clique "Create API key" → choisis un projet (ou crée-en un)
# 4. Copie la clé ici, et ajoute-la aussi dans les env vars Hostinger (hPanel → Node.js → Variables)
GEMINI_API_KEY=

# ─── Envoi d'emails SMTP (contact@klaivia.ch) ───
# Utilisé par le bouton « Envoyer email » et « Mail IA » sur la fiche prospect.
# Exemples par fournisseur :
#
# Google Workspace (recommandé pour @klaivia.ch) :
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false   (STARTTLS sur 587)
#   SMTP_USER=contact@klaivia.ch
#   SMTP_PASS=<mot de passe d'application Google, pas le mot de passe normal>
#   → générer sur https://myaccount.google.com/apppasswords (2FA requis)
#
# Infomaniak (hébergement Suisse) :
#   SMTP_HOST=mail.infomaniak.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=contact@klaivia.ch
#   SMTP_PASS=<mot de passe du compte mail>
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@klaivia.ch
SMTP_PASS=
# Expéditeur affiché dans l'email ("Nom <email>")
SMTP_FROM="Klaivia <contact@klaivia.ch>"
# Version exposée côté client (juste pour affichage dans le dialog)
NEXT_PUBLIC_SMTP_FROM="contact@klaivia.ch"
