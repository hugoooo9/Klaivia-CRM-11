# Klaivia CRM — variables d'environnement
# Copier vers .env et renseigner les valeurs avant de lancer le worker prospector.

# ─── DB (SQLite local par défaut) ───
DATABASE_URL="file:./klaivia.db"

# ─── Agent prospecteur IA ───
# Clé Anthropic pour scoring + génération de messages d'approche.
# Si absente : scoring et génération sont désactivés (fail-safe), enrichissement OK.
ANTHROPIC_API_KEY=

# Clé Google Places (New API) pour rating/avis/horaires.
# Si absente : enrichissement Google skippé (localCh + scraping continuent).
GOOGLE_PLACES_API_KEY=

# Zefix : endpoint public, gratuit, aucune clé. Ne modifier que pour tests.
ZEFIX_BASE_URL=https://www.zefix.ch/ZefixPublicREST

# Skip le filtrage heuristique NOGA (debug uniquement — importe TOUT hors cantons/NPA)
# ZEFIX_SKIP_NOGA_HEURISTIC=false

# ─── Worker cron ───
# Mettre à "true" UNIQUEMENT dans le process worker (npm run prospector:worker).
# Jamais dans Next.js runtime (sinon le cron tourne 2 fois).
PROSPECTOR_CRON=false

# ─── Envoi d'emails SMTP (contact@klaivia.ch) ───
# Utilisé par le bouton « Envoyer email » sur la fiche prospect.
# Exemples par fournisseur :
#
# Google Workspace (recommandé pour @klaivia.ch) :
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false   (STARTTLS sur 587)
#   SMTP_USER=contact@klaivia.ch
#   SMTP_PASS=<mot de passe d'application Google, pas le mot de passe normal>
#   → générer sur https://myaccount.google.com/apppasswords (2FA requis)
#
# Infomaniak (hébergement Suisse) :
#   SMTP_HOST=mail.infomaniak.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=contact@klaivia.ch
#   SMTP_PASS=<mot de passe du compte mail>
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@klaivia.ch
SMTP_PASS=
# Expéditeur affiché dans l'email ("Nom <email>")
SMTP_FROM="Klaivia <contact@klaivia.ch>"
# Version exposée côté client (juste pour affichage dans le dialog)
NEXT_PUBLIC_SMTP_FROM="contact@klaivia.ch"
